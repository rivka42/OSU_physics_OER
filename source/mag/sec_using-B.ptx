  <subsubsection>
	<title>Activities</title>
	
  </subsubsection>



	<activity xml:id="class_current-loop">
		<title>The Current Loop</title>
		<introduction>
			<p>
			
		</p>
		<p>
			A circular loop of wire carries a constant clockwise current <m>I</m>.
		</p>
		</introduction>
		<task>
			<statement>
				<p>
					What direction is the magnetic field at the center of the loop?
				</p>
			</statement>
			<hint>
				<p>
					Try adding up the magnetic fields from the current at a few different points around the loop.
				</p>
			</hint>
		</task>
		<task>
			<statement>
				<p>
					What strategy do you think you could use to find the magnitude of the magnetic field?
				</p>
			</statement>
			<solution>
				<p>
					<alert>Chop:</alert> <m>vdq = \frac{ds}{dt}dq = ds\frac{dq}{dt} = Ids</m>
				</p>
				<p>
					<alert>Multiply:</alert> <m>d\vec{B} = \frac{\mu_0}{4\pi}\frac{dq v}{R^2}(-\hat{z}) = \frac{\mu_0}{4\pi}\frac{IRd\theta}{R^2}(-\hat{z})</m>
				</p>
				<p>
					<alert>Add:</alert> <m>\vec{B} = \int d\vec{B} = \frac{\mu_0}{2}\frac{I}{R}(-\hat{z})</m>
				</p>
				<definition>
		<title>Magnetic Field Created by a Current</title>
		<statement>
			<p>
				
			</p>
			<p>The magnitude of the magnetic field created by a circular loop of radius <m>R</m> carrying current <m>I</m> at its center is <me>\vec{B} = \frac{\mu_0}{2}\frac{NI}{R}</me>
				Here <m>N</m> is the number of coils in the loop: <m>N = 1</m> for a single loop.
				</p>
<!--
			<figure xml:id="fig_mag-wire">
			<title>Long Wire Figure</title>
    		<caption>A test point near a long, current-carrying wire.  The direction of the magnetic field at the marked point is <alert>out of the screen</alert>.</caption>
    		<image source="LongWire.png" width = "100%" ><description>A straight line with a rightward arrow representing a current.  A distance s above the wire is a marked point.</description></image>
		</figure>
		-->
		</statement>
	</definition>	
			</solution>
		</task>
	</activity>

	


	
