<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="sec_faraday-practice" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Practice - Magnetic Induction</title>
	
	<!--
	If you want an A*R*C*S (Analyze-Represent-Calculate-Sensemake) activity, use the <project> tag.
	If you want an Explain activity, use the <investigation> tag.
		Use this text for qualitative comparisons: <em>greater than</em>, <em>less than</em>, or <em>equal to</em>
	If you want a Calculate activity, use the <exploration> tag.
	
	<m># \mathrm{~}</m>
	<m> \mathrm{~}</m>
	-->

	<project>
			<title>Magnetic Flux</title>
			<statement><p></p>
				<p>
					What is the magnetic flux through an equilateral triangle with side <m>60 \mathrm{~cm}</m> long, whose plane makes a 60 degree angle with a uniform magnetic field of <m>0.33 \mathrm{~T}</m>?
				</p>
			</statement>
			<!--
			<answer>
				<p>
					0.056 Wb
				</p>
			</answer>
			-->
		</project>

				

	<investigation>
		<title>The Moving Wire Loop</title>
		<statement><p></p>
			<p>
				The square wire loop below is located below a long straight wire carrying current <m>I_w</m>.  Each side of the circuit has length <m>l</m>.
			</p>
			<figure xml:id="fig-moving-loop">
				<caption>A square wire loop moving upward toward a wire.</caption>
				<image source="Moving-Loop.png" width = "40%" ></image>
			</figure>
			<p>
				Make a magnetic induction table for each of the following cases:
			</p>
			<ol marker="A:">
				<li>
					<p>
						The loop is moving upward with constant speed <m>v</m>. Choose an area vector into the page.
					</p>
				</li>
				<li>
					<p>
						Repeat case A, but choose the area vector to be in the opposite direction.
					</p>
				</li>
				<li>
					<p>
						Repeat case A, but now the loop is moving downward with constant speed <m>v</m>.
					</p>
				</li>
				<li>
					<p>
						Repeat case A, but now the loop is moving to the left with constant speed <m>v</m>.
					</p>
				</li>
				<li>
					<p>
						Repeat case A, but now the loop is stationary and the long straight wire is moving upward with constant speed <m>v</m>.
					</p>
				</li>
			</ol>
			<table>
  <title>Blank Magnetic Induction Table</title>
  <tabular halign="center">
    <row header="yes" bottom="minor" >
      <cell>Quantity</cell>
      <cell>Case A</cell>
	  <cell>Case B</cell>
	  <cell>Case C</cell>
	  <cell>Case D</cell>
	  <cell>Case E</cell>
    </row>
    <row>
      <cell><m>\vec{A}</m></cell>
      <cell></cell>
	  <cell></cell>
	  <cell></cell>
	  <cell></cell>
	  <cell></cell>
    </row>
    <row>
      <cell><m>\vec{B}</m></cell>
      <cell></cell>
	  <cell></cell>
	  <cell></cell>
	  <cell></cell>
	  <cell></cell>
    </row>
    <row>
      <cell><m>\Phi_B</m></cell>
      <cell></cell>
	  <cell></cell>
	  <cell></cell>
	  <cell></cell>
	  <cell></cell>
    </row>
    <row>
      <cell><m>\frac{d\Phi_B}{dt}</m></cell>
      <cell></cell>
	  <cell></cell>
	  <cell></cell>
	  <cell></cell>
	  <cell></cell>

    </row>
    <row>
      <cell><m>\mathcal{E}</m></cell>
      <cell></cell>
	  <cell></cell>
	  <cell></cell>
	  <cell></cell>
	  <cell></cell>

    </row>
		    <row>
      <cell><m>I_{ind}</m></cell>
      <cell></cell>
	  <cell></cell>
	  <cell></cell>
	  <cell></cell>
	  <cell></cell>

    </row>
		    <row>
      <cell><m>\vec{\mu}_{ind}</m></cell>
      <cell></cell>
	  <cell></cell>
	  <cell></cell>
	  <cell></cell>
	  <cell></cell>

    </row>
  </tabular>

</table>
		</statement>
	</investigation>





	<subsubsection>
		<title>A*R*C*S Practice</title>



		<project>
			<title>Square Loop in a Magnetic Field</title>
			<statement><p></p>
				<p>
					A square loop of wire with side length <m>6 \mathrm{~cm}</m> and resistance <m>0.4 \mathrm{~\Omega}</m> is in a uniform magnetic field <m>B = -0.008t^2</m> (in Tesla) that points in the <m>z</m>-direction (through the loop). Determine the current induced in the loop as a function of time (both magnitude and direction).
				</p>
			</statement>
		</project>



	</subsubsection>
		
	<subsubsection>
	<title>Numerical Practice</title>

		<exploration>
			<title>Induced Current</title>
			<statement><p></p>
				<p>
					A single conducting loop of wire has an area of <m>7.40 \times 10^{-2} \ \mathrm{m}^2</m> and a resistance of <m>110 \mathrm{~\Omega}</m>. Perpendicular to the plane of the loop is a magnetic field of strength <m>0.280 \mathrm{~T}</m>. At what rate (in T/s) must this field change if the induced current in the loop is to be <m>0.32 \mathrm{~}A</m>?
				</p>
			</statement>
			<answer>
				<p>
					<m>476 \mathrm{~T/s}</m>
				</p>
			</answer>
		</exploration>

		<figure xml:id="bs-loop-field">
			<title>Loop in a Magnetic Field</title>
			<caption>Circular conductive loop in a uniform magnetic field.</caption>
			<image source="mag/loop-field.png" width = "50%" ></image>
		</figure>

		<exploration>
			<title>Conductive Loop in a Magnetic Field</title>
			<statement><p></p>
				<p>
					A conductive metal loop is at rest within a uniform magnetic field, as shown above. If the magnetic field strength is then decreased, in which direction does induced current flow in the loop?
				</p>
			</statement>
			<answer>
				<p>
					There is no current.
				</p>
			</answer>
		</exploration>
	
		<figure xml:id="bs-falling-loop">
			<title>Loop falling Away from Current</title>
			<caption>Circular conductive loop falling away from a current carrying wire.</caption>
			<image source="mag/falling-loop.png" width = "50%" ></image>
		</figure>

		<exploration>
			<title>Falling Loop</title>
			<statement><p></p>
				<p>
					The figure shows a circular conductive loop falling away from a long wire that is carrying current to the right, as shown above. What is the direction of the induced current in the loop?
				</p>
			</statement>
			<answer>
				<p>
					Clockwise.
				</p>
			</answer>
		</exploration>
	</subsubsection>

