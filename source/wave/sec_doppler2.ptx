<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="sec_doppler2" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>The Doppler Effect</title>
	
	<subsubsection>
		<title>Activities</title>
		<activity>
			<title>The Airplane and the Balloon</title>
			<introduction>
				<p>
					
				</p>
				<p>
					Suppose an airplane is flying near a stationary balloon floating in the distance.
				</p>
			</introduction>
			<task>
				<statement>
					<p>
						How fast is the airplane moving (and in what direction) if the airplane hears a frequency from the balloon that is 3/4 of what the balloon claims it should be?
					</p>
				</statement>
			</task>
			<task>
				<statement>
					<p>
						How fast is the airplane moving (and in what direction) if the balloon hears a frequency from the airplane that is 3/4 of what the airplane claims it should be?
					</p>
				</statement>
			</task>
			<task>
				<statement>
					<p>
						What happens if one object is moving at a speed equal to the speed of sound?  Does your answer depend on which object is moving, or on which direction it is moving?
					</p>
				</statement>
			</task>
			
		</activity>
	</subsubsection>
	
<!--NO AI-->
</section>

